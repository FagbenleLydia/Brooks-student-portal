// prisma/schema.prisma

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ENUMS
enum UserRole {
  ADMIN
  STUDENT
  TEACHER
  PARENT
}

enum Gender {
  MALE
  FEMALE
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  LATE
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

// USER
model User {
  id           String   @id @default(cuid())
  firstName    String
  lastName     String
  email        String   @unique
  password     String
  phone        String?
  profileImage String?
  role         UserRole

  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  // RELATIONS
  student Student?
  teacher Teacher?

  announcements Announcement[]
}

//////////////////////////////////////////////////////
// FACULTY
//////////////////////////////////////////////////////

model Faculty {
  id          String       @id @default(cuid())
  name        String       @unique
  code        String       @unique

  createdAt   DateTime     @default(now())

  // RELATIONS
  departments Department[]
}

//////////////////////////////////////////////////////
// DEPARTMENT
//////////////////////////////////////////////////////

model Department {
  id          String    @id @default(cuid())
  name        String
  code        String    @unique

  facultyId   String
  faculty     Faculty   @relation(fields: [facultyId], references: [id])

  createdAt   DateTime  @default(now())

  // RELATIONS
  students    Student[]
  teachers    Teacher[]
  courses     Course[]
}

//////////////////////////////////////////////////////
// STUDENT
//////////////////////////////////////////////////////

model Student {
  id              String      @id @default(cuid())

  userId          String      @unique
  user            User        @relation(fields: [userId], references: [id])

  matricNumber    String      @unique
  gender          Gender
  dateOfBirth     DateTime
  address         String

  level           Int

  guardianPhone   String?
  admissionDate   DateTime

  departmentId    String
  department      Department  @relation(fields: [departmentId], references: [id])

  createdAt       DateTime    @default(now())

  // RELATIONS
  enrollments     Enrollment[]
  attendances     Attendance[]
  payments        Payment[]
}

//////////////////////////////////////////////////////
// TEACHER
//////////////////////////////////////////////////////

model Teacher {
  id              String      @id @default(cuid())

  userId          String      @unique
  user            User        @relation(fields: [userId], references: [id])

  staffId         String      @unique
  qualification   String
  specialization  String?

  hireDate        DateTime

  departmentId    String
  department      Department  @relation(fields: [departmentId], references: [id])

  createdAt       DateTime    @default(now())

  // RELATIONS
  courses         Course[]
}

    "/grades": {
      "post": {
        "tags": ["Grades"],
        "summary": "Record student grades",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["student", "course", "scores", "semester", "academicYear"],
                "properties": {
                  "student": { "type": "string" },
                  "course": { "type": "string" },
                  "scores": {
                    "type": "object",
                    "required": ["assignment", "midterm", "exam"],
                    "properties": {
                      "assignment": { "type": "number", "minimum": 0, "maximum": 30 },
                      "midterm": { "type": "number", "minimum": 0, "maximum": 30 },
                      "exam": { "type": "number", "minimum": 0, "maximum": 40 }
                    }
                  },
                  "semester": { "type": "string", "enum": ["first", "second"] },
                  "academicYear": { "type": "string" }
                }
              },
              "example": {
                "student": "64abc1234567890123456789",
                "course": "64def1234567890123456789",
                "scores": { "assignment": 25.5, "midterm": 22.0, "exam": 35.0 },
                "semester": "first",
                "academicYear": "2025/2026"
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Grade metadata stored cleanly" },
          "400": { "description": "Validation Error - Grade thresholds breached or missing reference tracking ids" }
        }
      }
    },
    "/grades/student/{studentId}": {
      "get": {
        "tags": ["Grades"],
        "summary": "Get all grades for a student + GPA",
        "parameters": [{ "name": "studentId", "in": "path", "required": true, "schema": { "type": "string" } }],
        "responses": { "200": { "description": "Grades and structural calculation values metrics maps" } }
      }
    },
    "/attendance": {
      "post": {
        "tags": ["Attendance"],
        "summary": "Mark attendance index details metrics",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["student", "course", "status", "date"],
                "properties": {
                  "student": { "type": "string" },
                  "course": { "type": "string" },
                  "status": { "type": "string", "enum": ["present", "absent", "late"] },
                  "date": { "type": "string", "format": "date-time" }
                }
              },
              "example": {
                "course": "64abc1234567890123456789",
                "student": "64def1234567890123456789",
                "status": "present",
                "date": "2026-05-23T10:00:00Z"
              }
            }
          }
        },
        "responses": {
          "201": { "description": "Attendance recorded" },
          "400": { "description": "Validation Error - Invalid status enum or malformed ISO date" }
        }
      }
    },
    "/announcements": {
      "get": {
        "tags": ["Announcements"],
        "summary": "Get all published announcements",
        "responses": { "200": { "description": "List of announcements" } }

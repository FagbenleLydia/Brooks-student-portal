# Server
PORT=5000
NODE_ENV=development

# MongoDB
# Replace with your MongoDB Atlas connection string
MONGO_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/portal_academy?retryWrites=true&w=majority

# JWT
# Use a long, random, secret string in production
JWT_SECRET=your_super_secret_jwt_key_change_this_in_production
JWT_EXPIRES_IN=7d

# Emailer
EMAIL_USER=your_email_name@example.com
EMAIL_PASS=your_google_app_password

# Default Admin Details
DEFAULT_FRISTNAME=first_name
DEFAULT_LASTNAME=last_name
DEFAULT_EMAIL=admin_email
DEFAULT_ROLE=admin
